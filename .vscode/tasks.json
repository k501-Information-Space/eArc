{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build k501_core",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-O2",
                "-ffloat-store",
                "-fno-fast-math",
                "-fno-unsafe-math-optimizations",
                "-fexcess-precision=standard",
                "-fno-strict-aliasing",
                "-fno-common",
                "${workspaceFolder}/src/*.c",
                "-I${workspaceFolder}/include",
                "-o",
                "${workspaceFolder}/k501_core.bin"
            ],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
